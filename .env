# Base URL of the backend API. Vite only exposes variables that start
# with VITE_ to browser code, so this is not a secret.
# Local dev: the Express server runs on http://localhost:7000.
VITE_API_BASE_URL=https://recipe-book-backend-ytdg.onrender.com
# On Vercel (production): set the same variable in
# Project Settings -> Environment Variables, value:
# https://<your-render-service>.onrender.com/api
# (no trailing slash), then redeploy.
