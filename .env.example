# Base URL of the backend API. Copy this file to .env for local development.
# Vite only exposes variables starting with VITE_ to browser code — these are
# NOT secrets (they are published in the built JS bundle).
# Local dev:  http://localhost:7000/api
# Production (Vercel): https://<your-render-service>.onrender.com/api
VITE_API_BASE_URL=https://recipe-book-backend-ytdg.onrender.com
